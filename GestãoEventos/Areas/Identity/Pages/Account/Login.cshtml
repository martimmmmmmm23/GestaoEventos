@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sessão";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="bg-theme-surface p-5 rounded-4 shadow-sm border-0">
            <div class="text-center mb-4">
                <h1 class="text-theme-main fw-bold">Bem-vindo</h1>
                <h7 class="text-theme-main">Introduza as suas credenciais para aceder</h7>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-group mb-4">
                    <label asp-for="Input.Email" class="form-label text-theme-main fw-bold mb-1">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="exemplo@email.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-group mb-4">
                    <label asp-for="Input.Password" class="form-label text-theme-main fw-bold mb-1">Palavra-passe</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="********" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label text-theme-muted" asp-for="Input.RememberMe">
                            Lembrar-me
                        </label>
                    </div>
                    @* VER COM GRUPO
                    <div>
                        <a id="forgot-password" asp-page="./ForgotPassword" style="color: var(--primary-accent); text-decoration: none;">Esqueceu-se da palavra-passe?</a>
                    </div>
                    *@
                </div>
                <div class="d-grid mb-4">
                    <button id="login-submit" type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">Entrar na Conta</button>
                </div>
                
                <div class="text-center">
                    <p class="text-theme-muted mb-2">
                        Ainda não tem conta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold" style="color: var(--primary-accent); text-decoration: none;">Registe-se aqui</a>
                    </p>
                    @*
                    <p class="text-theme-muted small mb-0">
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" style="color: var(--text-muted); text-decoration: underline;">Reenviar email de confirmação</a>
                    </p>
                    *@
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
