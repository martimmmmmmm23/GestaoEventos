@model IEnumerable<GestãoEventos.Data.Classes.Inscricao>

@{
    ViewData["Title"] = "Lista de Inscrições";
}

<h1>Inscrições Registadas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Adicionar Nova Inscrição</a>
</p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Evento</th>
            <th>Nome do Participante</th>
            <th>Email do Participante</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Evento.Nome)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Participante.Nome)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Participante.Email)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-eventoId="@item.EventoId" asp-route-participanteId="@item.ParticipanteId" class="btn btn-sm btn-warning">Editar</a> |
                    <a asp-action="Details" asp-route-eventoId="@item.EventoId" asp-route-participanteId="@item.ParticipanteId" class="btn btn-sm btn-info">Detalhes</a> |
                    <a asp-action="Delete" asp-route-eventoId="@item.EventoId" asp-route-participanteId="@item.ParticipanteId" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>