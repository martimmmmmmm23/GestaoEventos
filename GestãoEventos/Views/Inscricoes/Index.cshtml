@model IEnumerable<GestãoEventos.Data.Classes.Inscricao>

@{
    ViewData["Title"] = "Lista de Inscrições";
}
<h1 class="text-theme-main fw-bold my-4">Inscrições Registadas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-lg"></i> Nova Inscrição
    </a>
</p>

<div class="=" bg-theme-surface p-3 rounded-3 shadow-sm">
    <table class="table">
        <thead class="text-theme-main">
            <tr>
                <th>Nome do Evento</th>
                <th>Nome do Participante</th>
                <th>Email do Participante</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>

        <tbody class="text-theme-main">
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Evento.Nome</td>
                    <td class="fw-bold">@item.Participante.Nome</td>
                    <td class="fw-bold">@item.Participante.Email</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-eventoId="@item.EventoId" asp-route-participanteId="@item.ParticipanteId" class="mx-1" style="color: var(--primary-accent);">Editar</a> |
                        <a asp-action="Details" asp-route-eventoId="@item.EventoId" asp-route-participanteId="@item.ParticipanteId" style="color: var(--primary-accent);">Detalhes</a> |
                        <a asp-action="Delete" asp-route-eventoId="@item.EventoId" asp-route-participanteId="@item.ParticipanteId" class="mx-1" style="color: var(--primary-accent);">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>