@model GestãoEventos.ViewModel.Inscricoes.InscricaoViewModel

@{
    ViewData["Title"] = "Eliminar Inscrição";
}

<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
<h3>Tem a certeza que quer eliminar esta inscrição?</h3>

<div>
    <hr />
    <dl class="row text-theme-main">
        <dt class="col-sm-3 text-theme-muted">Nome do Participante</dt>
        <dd class="col-sm-9 te">@Model.Nome</dd>

        <dt class="col-sm-3 text-theme-muted">Email do Participante</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3 text-theme-muted">Nome do Evento</dt>
        <dd class="col-sm-9">@Model.NomeEvento</dd>
    </dl>

    <div class="mt-4">
        <form asp-action="Delete">
            <input type="submit" asp-route-participanteId="@Model.ParticipanteId" asp-route-eventoId="@Model.EventoId" value="Eliminar" class="btn btn-danger px-5 rounded-pill" />
            <a asp-controller="Eventos" asp-action="Details" asp-route-id="@Model.EventoId" class="btn btn-secondary px-5 rounded-pill">Cancelar</a>
        </form>
    </div>
</div>