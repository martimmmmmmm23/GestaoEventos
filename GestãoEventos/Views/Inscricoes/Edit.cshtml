@model GestãoEventos.Data.Classes.Inscricao

@{
    ViewData["Title"] = "Editar Inscrição";
}

<h1>Editar</h1>

<h4>Alterar Inscrição</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Parâmetros antigos para o Controller conseguir encontrar a inscrição original *@
            <input type="hidden" name="oldEventoId" value="@Model.EventoId" />
            <input type="hidden" name="oldParticipanteId" value="@Model.ParticipanteId" />

            <div class="form-group mb-3">
                <label asp-for="EventoId" class="control-label">Alterar Evento</label>
                <select asp-for="EventoId" class="form-control" asp-items="ViewBag.EventoId"></select>
                <span asp-validation-for="EventoId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ParticipanteId" class="control-label">Alterar Participante</label>
                <select asp-for="ParticipanteId" class="form-control" asp-items="ViewBag.ParticipanteId"></select>
                <span asp-validation-for="ParticipanteId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar Alterações" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Voltar à Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}