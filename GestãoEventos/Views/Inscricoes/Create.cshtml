@model GestãoEventos.ViewModel.Inscricoes.InscricaoViewModel

@{
    ViewData["Title"] = "Criar";
}

<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
<h4 class="text-theme-muted">Nova Inscrição</h4>
<hr class="border-color" />

<form asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row align-items-stretch">
        <div class="col-md-6">
            <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">
                <div class="form-group mb-3">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="exemplo@email.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>

                    @if (ViewBag.MostrarLinkRegisto == true)
                    {
                        <div class="mt-2 p-3 border border-warning rounded bg-light">
                            <strong>Gostaria de criar conta?</strong>
                            <p class="text-muted mb-2 small">Parece que este e-mail ainda não está registado. Pode criar uma conta agora ou corrigir o e-mail acima.</p>
                            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-sm btn-outline-primary">Criar Nova Conta</a>
                        </div>
                    }
                </div>
                <div class="form-group mb-3">
                    <label asp-for="EventoId" class="control-label">Selecionar Evento</label>
                    <select asp-for="EventoId" id="DropdownEvento" class="form-control" asp-items="Model.EventosDisponiveis">
                        <option value="">-- Escolha um evento --</option>
                    </select>
                    <span asp-validation-for="EventoId" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Confirmar" class="btn btn-primary px-5 rounded-pill" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">Voltar à Lista</a>
                </div>  
            </div>
        </div>
        <div class="col-md-6">
            <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">
                <div id="ContentDetalhesEvento">
                    @if (Model?.EventoSelecionado != null)
                    {
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">@Model.EventoSelecionado.Nome</h5>
                            </div>
                            <div class="card-body">
                                <p><strong>Data:</strong> @Model.EventoSelecionado.Data.ToString("dd/MM/yyyy")</p>
                                <p><strong>Local:</strong> @Model.EventoSelecionado.Local</p>
                                <p class="mb-0">@Model.EventoSelecionado.Descricao</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">Selecione um evento e clique em "Ver" para carregar os detalhes.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}