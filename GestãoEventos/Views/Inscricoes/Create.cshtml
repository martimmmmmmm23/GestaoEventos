@model GestãoEventos.ViewModel.Inscricoes.InscricaoViewModel

@{
    ViewData["Title"] = "Criar";
}
<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
<h4 class="text-theme-muted">Nova Inscrição</h4>
<hr class="border-color" />

<form asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row align-items-stretch">
        <div class="col-md-6">
            <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">
                <div class="form-group mb-3">
                    <label asp-for="Email" class="control-label"></label>

                    @* O campo fica 'readonly' se o utilizador estiver logado E NÃO for Organizador *@
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="exemplo@email.com"
                           readonly="@(User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Organizador") ? "readonly" : null)" />

                    <span asp-validation-for="Email" class="text-danger"></span>

                    @if (ViewBag.MostrarLinkRegisto == true)
                    {
                        <div class="mt-2 p-3 border bg-theme-surface rounded">
                            <strong>Gostaria de criar conta?</strong>
                            <p class="text-muted mb-2 small">Parece que este e-mail ainda não está registado. Pode criar uma conta agora ou corrigir o e-mail acima.</p>
                            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-sm btn-outline-primary">Criar Nova Conta</a>
                        </div>
                    }
                </div>
                <div class="form-group mb-3">
                    <label asp-for="EventoId" class="control-label">Selecionar Evento</label>
                    <select asp-for="EventoId" id="DropdownEvento" class="form-control" asp-items="Model.EventosDisponiveis"
                            onchange="this.form.action='/Inscricoes/CarregarDetalhes'; this.form.submit();">
                        <option value="">-- Escolha um evento --</option>
                    </select>
                    <span asp-validation-for="EventoId" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Confirmar" class="btn btn-primary px-5 rounded-pill" />
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">Voltar à Lista</a>
                </div>  
            </div>
        </div>
        <div class="col-md-6">
            <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">
                @if (Model?.EventoSelecionado != null)
                {
                    <div class="d-flex flex-column h-100">
                        <h3 class="text-theme-main fw-bold mb-1 text-break">@Model.EventoSelecionado.Nome</h3>
                        <hr class="border-color my-3" />

                        <div class="row g-3 flex-grow-1">
                            <dl class="row text-theme-main">
                                <dt class="col-sm-3 text-theme-muted">Data</dt>
                                <dd class="col-sm-9">@Model.EventoSelecionado.Data.ToString("dd MMM yyyy")</dd>

                                <dt class="col-sm-3 text-theme-muted">Hora</dt>
                                <dd class="col-sm-9">@Model.EventoSelecionado.Hora.ToString(@"hh\:mm")</dd>

                                <dt class="col-sm-3 text-theme-muted">Local</dt>
                                <dd class="col-sm-9 text-break">@Model.EventoSelecionado.Local</dd>

                                <dt class="col-sm-3 text-theme-muted">Preço</dt>
                                @if (Model.EventoSelecionado.Preco != null && Model.EventoSelecionado.Preco != 0)
                                {
                                    <dd class="col-sm-9 text-break">@Model.EventoSelecionado.Preco €</dd>
                                }
                                else
                                {
                                    <dd class="col-sm-9 text-break">Grátis</dd>
                                }

                                <dt class="col-sm-3 text-theme-muted">Descrição</dt>
                                <dd class="col-sm-9 text-break">@Model.EventoSelecionado.Descricao</dd>
                            </dl>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">Selecione um evento para carregar os detalhes.</p>
                }
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}