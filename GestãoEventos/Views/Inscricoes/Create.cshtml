@model GestãoEventos.ViewModel.Inscricoes.InscricaoViewModel

@{
    ViewData["Title"] = "Inscrições";
}

@* Mostra um título diferente consoante o evento já venha pré-selecionado ou não *@
@if (!string.IsNullOrEmpty(Model.NomeEvento))
{
    <h2>Inscrição no Evento: <span class="text-primary">@Model.NomeEvento</span></h2>
}
else
{
    <h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
    <h4 class="text-theme-muted">Inscrições</h4>
    <hr class="border-color" />
}
<div class="row">
    <div class="col-md-6">
        <div class="bg-theme-surface p-4 rounded-3 shadow-sm">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="EventoId" />

                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" placeholder="exemplo@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>

                @* BLOCO NOVO: Só aparece se o Controller não encontrar o email *@
                @if (ViewBag.MostrarLinkRegisto == true)
                {
                    <div class="mt-2 p-3 border border-warning rounded bg-light">
                        <strong>Gostaria de criar conta?</strong>
                        <p class="text-muted mb-2 small">Parece que este e-mail ainda não está registado. Pode criar uma conta agora ou corrigir o e-mail acima.</p>

                        @* ATENÇÃO: Ajusta este link para a tua página de registo real *@
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-sm btn-outline-primary">Criar Nova Conta</a>
                    </div>
                }

                <div class="form-group mb-3">
                    <label asp-for="EventoId" class="control-label">Selecionar Evento</label>
                    <select asp-for="EventoId" class="form-control" asp-items="Model.EventosDisponiveis">
                        <option value="">-- Escolha um evento --</option>
                    </select>
                    <span asp-validation-for="EventoId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Confirmar Inscrição" class="btn btn-success" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Voltar à Lista</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}