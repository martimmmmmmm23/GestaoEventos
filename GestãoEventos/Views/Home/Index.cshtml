@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@model IEnumerable<GestãoEventos.Data.Classes.Evento> //listar vários eventos
@{
    ViewData["Title"] = "Bem-vindo";
    var agora = DateTime.Now;

    var eventosFuturos = Model?.Where(e => e.Data >= agora).OrderBy(e => e.Data).ToList() 
                        ?? new List<GestãoEventos.Data.Classes.Evento>();

    var eventosPassados = Model?.Where(e => e.Data < agora).OrderByDescending(e => e.Data).ToList()
                        ?? new List<GestãoEventos.Data.Classes.Evento>();
}
<head>
    <link rel="stylesheet" href="../Views/Home/Index.css" asp-append-version="true" />
</head>
<header class="hero-bg text-center py-5 mb-5 text-theme-main">
    <div class="container">
        <h1 class="display-4 fw-bold">Gestão de Eventos</h1>
        <p class="lead">Descubra e gira os melhores eventos num único lugar.</p>
        <a href="#proximos" class="btn btn-primary btn-lg mt-3 rounded-pill px-4">Ver Próximos Eventos</a>
    </div>
</header>

<div class="container my-5">
    <!-- Próximos Eventos -->
    <section id="proximos" class="mb-5">
        <h2 class="titulo-sessao mb-4 text-theme-main fw-bold">Próximos Eventos</h2>
        <div class="row g-4">
            @if (!eventosFuturos.Any())
            {
                <div class="col-12 text-center py-5 rounded bg-theme-surface">
                    <p class="text-theme-muted fs-5">Não há eventos agendados de momento.</p>
                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Organizador"))
                    {
                          <a asp-controller="Eventos" asp-action="Create" class="btn btn-theme fw-bold">Criar Novo Evento</a>
                    }
                </div>
            }
            else
            {
                @foreach (var item in eventosFuturos)
                {
                    <div class="col-md-4">
                        <div class="card h-100 cartao-evento bg-theme-surface border-0 shadow-sm">
                            <div class="img-placeholder text-center py-2 rounded-top" style="background-color: var(--primary-accent); color: var(--bg-surface);">
                                <label class="btn btn-lg btn-primary w-100 fw-bold">@item.Nome</label>
                            </div>
                            
                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center fw-bold small text-uppercase mb-2">
                                    <span class="fs-6">
                                    @if (item.Lugares == null)
                                    {
                                            <span class="badge bg-success text-white rounded-pill px-3 py-1 fw-bold" style="letter-spacing: 0.5px; box-shadow: 0 2px 5px rgba(25, 135, 84, 0.4);">Ilimitado</span>
                                    }
                                    else if (item.Lugares > item.Inscricoes.Count())
                                    {
                                            <span class="badge bg-success text-white rounded-pill px-3 py-1 fw-bold" style="letter-spacing: 0.5px; box-shadow: 0 2px 5px rgba(25, 135, 84, 0.4);">
                                            @(item.Lugares - item.Inscricoes.Count()) Disponíveis
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-3 py-1 fw-bold">Esgotado</span>
                                    }
                                    </span>
                                    <span class="fs-6">
                                        @if (item.Preco == 0)
                                        {
                                            <span class="badge bg-success text-white rounded-pill px-3 py-1 fw-bold" style="letter-spacing: 0.5px; box-shadow: 0 2px 5px rgba(25, 135, 84, 0.4);">GRÁTIS</span>
                                        }
                                        else
                                        {
                                            @item.Preco.ToString("0.00 €")
                                        }
                                    </span>

                                </div>
                                <div class="d-flex justify-content-between align-items-center fw-bold small text-uppercase mb-2">
                                    <span>@item.Data.ToString("dd MMM yyyy") | @item.Hora.ToString(@"hh\:mm")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Image))
                                {
                                    <img src="@item.Image" alt="Cartaz de @item.Nome" class="img-fluid w-100 rounded mb-3" style="height: 200px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="~/images/imageDefault.png" alt="Logotipo Acontece" class="img-fluid w-100 rounded mb-3" style="height: 200px; object-fit: cover;" />
                                }
                                <p class="card-text text-theme-muted small"><i class="bi bi-geo-alt"></i> @item.Local</p>
                            </div>
                            <div class="card-footer bg-transparent border-0 pb-3 pt-0">
                                <a asp-controller="Inscricoes" asp-action="Create" asp-route-id="@item.Id" class="btn btn-sm btn-primary w-100 py-2 fw-bold">Inscreva-se</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    <hr class="my-5" style="border-color: var(--border-color) !important; opacity: 1;">

    <!-- Eventos Passados -->
    <section id="passados">
        <h2 class="titulo-sessao mb-4 text-theme-main fw-bold">Eventos Realizados</h2>
        <div class="row g-4">
            @foreach (var item in eventosPassados)
            {
                <div class="col-md-4">
                    <div class="card h-100 cartao-evento-passado bg-theme-surface border-0 shadow-sm">
                        <div class="card-body">
                            <span class="badge bg-secondary bg-opacity-75 mb-2 px-3 rounded-pill">Realizado</span>
                            <div class="text-theme-muted small mb-1">@item.Data.ToString("dd MMM, yyyy")</div>
                            <h5 class="card-title text-theme-main fw-bold">@item.Nome</h5>
                            <p class="card-text text-theme-muted small">@item.Local</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>