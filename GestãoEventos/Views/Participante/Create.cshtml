@model GestãoEventos.ViewModel.Participantes.ParticipanteViewModel

@{
    ViewData["Title"] = "Criar";
}

<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
<h4 class="text-theme-muted">Participante</h4>
<hr class="border-color" />

<div class="row">
    <div class="col-md-6">
        <div class="bg-theme-surface p-4 rounded-3 shadow-sm">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Nome" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmarEmail" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="ConfirmarEmail" class="form-control" />
                    <span asp-validation-for="ConfirmarEmail" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Confirmar" class="btn btn-primary px-5 rounded-pill"/>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">Voltar à Lista</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}