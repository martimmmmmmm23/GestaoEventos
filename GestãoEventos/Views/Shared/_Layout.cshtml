@using GestãoEventos.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject GestaoEventosDbContext Context

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestão de Eventos</title>

    
    <!--  DARK MODE FIX (EVITA FLASH) -->
    <script>
            (function () {
                const tema = localStorage.getItem('theme');

                if (tema === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestãoEventos.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Alteramos as cores do menu aqui -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3 py-1 theme-bar">
            <div class="container-fluid">
                <!-- Nome principal no canto superior esquerdo e logotipo -->
                <a class="navbar-brand font-weight-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/imageLogotipo.png" alt="Logotipo Gestão de Eventos" height="40" class="me-3 rounded" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Organizador"))
                            {
                            <li class="nav-item mx-1">
                                <a class="nav-link fs-6" asp-area="" asp-controller="Eventos" asp-action="Index">Eventos</a>
                            </li>
                            <div class="vr opacity-25 my-2" style="height: 30px;"></div>
                            <li class="nav-item mx-1">
                                <a class="nav-link fs-6" asp-area="" asp-controller="Participantes" asp-action="Index">Utilizadores</a>
                            </li>
                            @* <div class="vr opacity-25 my-2" style="height: 30px;"></div>
                            <li class="nav-item mx-1">
                                <a class="nav-link fs-6" asp-area="" asp-controller="Inscricoes" asp-action="Index">Inscrições</a>
                            </li> *@
                            }
                        </ul>
                    <li class="nav-item me-3 d-flex align-items-center">
                        <div class="form-check form-switch mb-0" title="Mudar Tema">
                            <input class="form-check-input" type="checkbox" role="switch" id="themeSwitch" style="cursor: pointer;">

                            <label class="form-check-label ms-1" for="themeSwitch" id="themeLabel" style="cursor: pointer;">
                                ☼
                            </label>
                        </div>
                    </li>
                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            // O UTILIZADOR ESTÁ LOGADO
                            <li class="nav-item">
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    // Vai buscar o utilizador do Identity
                                    var currentUser = await UserManager.GetUserAsync(User);
                                    var userEmail = currentUser?.Email;
                                    var nomeAExibir = currentUser?.NomeCompleto ?? User.Identity?.Name;

                                    // Vai buscar o ID do Participante correspondente
                                    var participante = Context.Participantes.FirstOrDefault(p => p.Email == userEmail);

                                    if (participante != null)
                                    {
                                        // Se o participante existir na base de dados, o link vai para o Edit do MVC normal
                                        <a class="nav-link fs-6" asp-area="" asp-controller="Participantes" asp-action="Edit" asp-route-id="@participante.Id" title="Editar Perfil">
                                            Olá, @nomeAExibir!
                                        </a>
                                    }
                                }
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="nav-link fs-6 bg-transparent border-0" style="color: inherit;">Sair</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            // O UTILIZADOR É ANÓNIMO
                            <li class="nav-item">
                                <a class="nav-link fs-6" asp-area="Identity" asp-page="/Account/Register">Registar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fs-6" asp-area="Identity" asp-page="/Account/Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Alteramos as cores e o alinhamento do rodapé aqui -->
    <footer class="border-top footer py-2 theme-bar" style="line-height: normal;">
        <div class="container-fluid d-flex justify-content-between align-items-start">
            <div class="d-flex flex-column align-items-start small">
                <div class="fw-bold text-nowrap">Trabalho do Grupo 1</div>
                <div class="text-nowrap">Rafael, João R., Leonor, Madalena, Martim</div>
            </div>
            <div class="d-flex flex-column align-items-end small">
                <div class="fw-bold text-nowrap">UC00608</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        const themeSwitch = document.getElementById('themeSwitch');
        const themeLabel = document.getElementById('themeLabel');
        const htmlElement = document.documentElement;

        //Qunado mudamos o botao do tema, grava a escolha
        const savedTheme = localStorage.getItem('theme'); //Verifica se tem algum 'bilhete' guardado

        if (savedTheme === 'dark') {
            htmlElement.setAttribute('data-theme', 'dark');
            themeSwitch.checked = true; // Garante que o botão deslizante está ligado
            themeLabel.innerText = '☾';
        }
        // Fica à espera que o botão deslize
        themeSwitch.addEventListener('change', function () {

            // Se o botão estiver ligado (checked)...
            if (this.checked) {
                // 1. Ativa o Modo Escuro no teu CSS
                document.documentElement.setAttribute('data-theme', 'dark');
                // 2. Troca o ícone para a Lua
                themeLabel.innerHTML = '☾';
                localStorage.setItem('theme', 'dark'); //Cria um 'bilhete' theme com o valor 'dark'
            }
            // Se o botão for desligado...
            else {
                // 1. Desliga o Modo Escuro (volta ao Claro)
                document.documentElement.setAttribute('data-theme', 'light');
                // 2. Troca o ícone para o Sol
                themeLabel.innerHTML = '☼';
                localStorage.setItem('theme', 'light');
            }
        });
    </script>
</body>
</html>
