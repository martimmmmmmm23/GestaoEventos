<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestão de Eventos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestãoEventos.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Alteramos as cores do menu aqui -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3 py-1 theme-bar">
            <div class="container-fluid">
                <!-- Nome principal no canto superior esquerdo e logotipo -->
                <a class="navbar-brand font-weight-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logotipo.png" alt="Logotipo Gestão de Eventos" height="40" class="me-3 rounded" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item mx-1">
                            <a class="nav-link fs-6" asp-area="" asp-controller="Eventos" asp-action="Index">Eventos</a>
                        </li>
                        <div class="vr opacity-25 my-2" style="height: 30px;"></div>
                        <li class="nav-item mx-1">
                            <a class="nav-link fs-6" asp-area="" asp-controller="Participantes" asp-action="Index">Participantes</a>
                        </li>
                    </ul>
                    <li class="nav-item me-3 d-flex align-items-center">
                        <div class="form-check form-switch mb-0" title="Mudar Tema">
                            <input class="form-check-input" type="checkbox" role="switch" id="themeSwitch" style="cursor: pointer;">

                            <label class="form-check-label ms-1" for="themeSwitch" id="themeLabel" style="cursor: pointer;">
                                ☼
                            </label>
                        </div>
                    </li>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="btn btn-theme fw-bold px-4" asp-area="Identity" asp-page="/Account/Login">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Alteramos as cores e o alinhamento do rodapé aqui -->
    <footer class="border-top footer py-2 theme-bar" style="line-height: normal;">
        <div class="container-fluid d-flex justify-content-between align-items-start">
            <div class="d-flex flex-column align-items-start small">
                <div class="fw-bold text-nowrap">Trabalho do Grupo 1</div>
                <div class="text-nowrap">Rafael, João R., Leonor, Madalena, Martim</div>
            </div>
            <div class="d-flex flex-column align-items-end small">
                <div class="fw-bold text-nowrap">UC00608</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        const themeSwitch = document.getElementById('themeSwitch');
        const themeLabel = document.getElementById('themeLabel');

        // Fica à espera que o botão deslize
        themeSwitch.addEventListener('change', function () {

            // Se o botão estiver ligado (checked)...
            if (this.checked) {
                // 1. Ativa o Modo Escuro no teu CSS
                document.documentElement.setAttribute('data-theme', 'dark');
                // 2. Troca o ícone para a Lua
                themeLabel.innerHTML = '☾';
            }
            // Se o botão for desligado...
            else {
                // 1. Desliga o Modo Escuro (volta ao Claro)
                document.documentElement.setAttribute('data-theme', 'light');
                // 2. Troca o ícone para o Sol
                themeLabel.innerHTML = '☼';
            }
        });
    </script>
</body>
</html>
