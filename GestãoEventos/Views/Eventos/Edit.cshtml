@model GestãoEventos.ViewModel.Eventos.EventoViewModel

@{
    ViewData["Title"] = "Editar";
}

<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
<h4 class="text-theme-muted">Evento</h4>
<hr class="border-color" />

<div class="row">
    <div class="col-md-6">
        <div class="bg-theme-surface p-4 rounded-3 shadow-sm">
            <form asp-action="Edit" asp-route-id="@ViewBag.Id">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Nome" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Data" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Data" class="form-control" type="date" />
                    <span asp-validation-for="Data" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Local" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Local" class="form-control" />
                    <span asp-validation-for="Local" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Guardar alterações" class="btn btn-primary px-5 rounded-pill" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">Voltar à Lista</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}