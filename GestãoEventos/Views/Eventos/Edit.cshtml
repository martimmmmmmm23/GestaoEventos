@model GestãoEventos.ViewModel.Eventos.EventoViewModel

@{
    ViewData["Title"] = "Editar";
}

<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
<h4 class="text-theme-muted">Evento</h4>
<hr class="border-color" />

<form asp-action="Edit" asp-route-id="@ViewBag.Id" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row align-items-stretch">
        <div class="col-md-6">
            <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">
                <div class="form-group mb-3">
                    <label asp-for="Nome" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Data" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Data" class="form-control" type="date" />
                    <span asp-validation-for="Data" class="text-danger"></span>
                </div>

                @* <div class="form-group mb-3">
                    <label asp-for="Hora" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Hora" class="form-control" type="time" />
                    <span asp-validation-for="Hora" class="text-danger"></span>
                </div> *@

                <div class="form-group mb-3">
                    <label asp-for="Local" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Local" class="form-control" />
                    <span asp-validation-for="Local" class="text-danger"></span>
                </div>

                @* <div class="form-group mb-3">
                    <label asp-for="Preco" class="control-label text-theme-main fw-bold mb-1"></label>
                    <div class="input-group">
                        <input asp-for="Preco" class="form-control" type="number" step="0.01" min="0" />
                        <span class="input-group-text bg-theme-surface text-theme-main">€</span>
                    </div>
                    <span asp-validation-for="Preco" class="text-danger"></span>
                </div> *@
            </div>
        </div>
        <div class="col-md-6">
            <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <div class="mb-3 p-2 border border-color rounded-3 text-center bg-theme-background">
                        <p class="text-theme-muted small mb-2 fw-bold">Imagem Atual:</p>
                        <img src="@Model.Image" alt="Capa do Evento" class="img-fluid rounded-2 shadow-sm" style="max-height: 120px; object-fit: cover;" />
                    </div>
                }

                <div class="form-group mb-3">
                    <label asp-for="ImageFile" class="control-label text-theme-main fw-bold mb-1">
                        @(string.IsNullOrEmpty(Model.Image) ? "Carregar Nova Imagem" : "Substituir Imagem")
                    </label>
                    <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                    <small class="text-theme-muted">Tamanho máximo: 5MB. Deixe em branco para manter a atual.</small>
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Descricao" class="control-label text-theme-main fw-bold mb-1"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Guardar alterações" class="btn btn-primary px-5 rounded-pill" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">Voltar à Lista</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}