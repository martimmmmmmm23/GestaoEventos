@model GestãoEventos.ViewModel.Eventos.EventoViewModel

@{
    ViewData["Title"] = "Criar";
}

<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
<h4 class="text-theme-muted">Evento</h4>
<hr class="border-color" />

<form asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row align-items-stretch">
        <div class="col-md-6">
            <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">

                <div class="form-group mb-3">
                    <label asp-for="Nome" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Data" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Data" class="form-control" type="date" />
                    <span asp-validation-for="Data" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Hora" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Hora" class="form-control" type="time" />
                    <span asp-validation-for="Hora" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Local" class="control-label text-theme-main fw-bold mb-1"></label>
                    <input asp-for="Local" class="form-control" />
                    <span asp-validation-for="Local" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Lugares" class="control-label text-theme-main fw-bold mb-1"></label>
                    <div class="input-group">
                        <input asp-for="Lugares" class="form-control" type="number" placeholder="500" />
                    </div>
                    <span asp-validation-for="Lugares" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Preco" class="control-label text-theme-main fw-bold mb-1"></label>
                    <div class="input-group">
                        <input asp-for="Preco" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                        <span class="input-group-text bg-theme-surface text-theme-main">€</span>
                    </div>
                    <span asp-validation-for="Preco" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">
                <div class="form-group mb-3">
                    <label asp-for="ImageFile" class="control-label text-theme-main fw-bold mb-1">Imagem do Evento</label>
                    <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg, .jpeg, .png, .webp" id="fotoUpload" /> @*etiqueta id para o javascript saber onde esta o campo upload e validar*@
                    <small class="text-theme-muted">Tamanho máximo: 5MB</small>
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Descricao" class="control-label text-theme-main fw-bold mb-1"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Breve resumo do evento..."></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Confirmar" class="btn btn-primary px-5 rounded-pill" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">Voltar à Lista</a>
                </div>
            
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        //O JS procura na página HTML a etiqueta id="fotoUpload". O "addEventListener" diz ao navegador para ficar atento.
        //Sempre que houver uma 'change' (utilizador escolher um ficheiro novo), ele executa a função abaixo.
        document.getElementById('fotoUpload').addEventListener('change', function () {

            //guarda o valor exato de 5MB em bytes
            const maxTamanho = 5 * 1024 * 1024;

            //"this" representa o botão de upload clicado.
            //"this.files[0]" verifica se o ficheiro número zero (o primeiro e único ficheiro selecionado) existe.
            //"this.files[0].size > maxTamanho" verifica se o peso desse ficheiro é maior que o limite que definimos.
            if (this.files[0] && this.files[0].size > maxTamanho) {

                //Se a imagem for pesada demais, o "alert" faz saltar o aviso.
                alert('Atenção: A imagem escolhida tem mais de 5MB. Por favor, escolha um ficheiro mais pequeno.');

                //O "this.value = '' limpa a caixa do input, apagando a seleção da foto
                this.value = '';
            }
        });
    </script>
}