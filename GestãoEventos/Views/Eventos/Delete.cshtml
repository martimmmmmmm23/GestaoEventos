@model GestãoEventos.Data.Classes.Evento

@{
    ViewData["Title"] = "Eliminar";
}

<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
<h3>Tem a certeza que quer eliminar este evento?</h3>

<div>
    <hr />
    <dl class="row text-theme-main">
        <dt class="col-sm-3 text-theme-muted">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>

        <dt class="col-sm-3 text-theme-muted">Data</dt>
        <dd class="col-sm-9">@Model.Data.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3 text-theme-muted">Hora</dt>
        <dd class="col-sm-9">@Model.Hora</dd>

        <dt class="col-sm-3 text-theme-muted">Local</dt>
        <dd class="col-sm-9">@Model.Local</dd>
    </dl>

    <div class="mt-4">
        <form asp-action="Delete">
            <input type="submit" value="Eliminar" class="btn btn-danger px-5 rounded-pill" />
            <a asp-action="Index" class="btn btn-secondary px-5 rounded-pill">Cancelar</a>
        </form>
    </div>
</div>