@model GestãoEventos.Data.Classes.Evento

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Tem a certeza que quer eliminar este evento?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Nome</dd>

        <dt class="col-sm-2">Data</dt>
        <dd class="col-sm-10">@Model.Data.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Local</dt>
        <dd class="col-sm-10">@Model.Local</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>