@model IEnumerable<GestãoEventos.Data.Classes.Evento>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-theme-main fw-bold my-4">Eventos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-lg"></i> Novo Evento
    </a>
</p>

<div class="="bg-theme-surface p-3 rounded-3 shadow-sm">
    <table class="table">
        <thead class="text-theme-main">
            <tr>
                <th>Nome</th>
                <th>Data</th>
                <th>Hora</th>
                <th>Local</th>
                <th>Preço</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>

        <tbody class="text-theme-main">
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Nome</td>
                    <td>@item.Data.ToString("dd/MM/yyyy")</td>
                    @* <td>@item.Hora</td> *@
                    <td>@item.Local</td>
                    @* <td>@item.Preço</td> *@
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="mx-1" style="color: var(--primary-accent);">Editar</a> |
                        <a asp-action="Details" asp-route-id="@item.Id" class="mx-1" style="color: var(--primary-accent);">Detalhes</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id" class="mx-1" style="color: var(--primary-accent);">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>