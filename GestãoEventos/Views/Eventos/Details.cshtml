@model GestãoEventos.ViewModel.Eventos.EventoViewModel

@{
    ViewData["Title"] = "Detalhes do Evento";
}

<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>
<hr class="border-color" />

<div class="row align-items-stretch">
    <div class="col-md-6">
        <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">
            <dl class="row text-theme-main">
                <dt class="col-sm-3 text-theme-muted">Nome</dt>
                <dd class="col-sm-9 fw-bold">@Model.Nome</dd>

                <dt class="col-sm-3 text-theme-muted">Data</dt>
                <dd class="col-sm-9">@Model.Data.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3 text-theme-muted">Hora</dt>
                <dd class="col-sm-9 fw-bold">@Model.Hora</dd>

                <dt class="col-sm-3 text-theme-muted">Local</dt>
                <dd class="col-sm-9">@Model.Local</dd>

                <dt class="col-sm-3 text-theme-muted">Preço</dt>
                <dd class="col-sm-9">@Model.Preco</dd>

                <dt class="col-sm-3 text-theme-muted">Descrição</dt>
                <dd class="col-sm-9">@Model.Descricao</dd>
            </dl>
        </div>
    </div>
    <div class="col-md-6">
        <div class="bg-theme-surface p-4 rounded-3 shadow-sm h-100">
            <h5 class="text-theme-main fw-bold mb-3">Lista de Participantes</h5>

            @if (Model.Inscricoes != null && Model.Inscricoes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="text-theme-muted small text-uppercase">
                                <th scope="col" class="py-3">Nome do Participante</th>
                                <th scope="col" class="py-3">Email do Participante</th>
                                <th scope="col" class="py-3 text-end">Ação</th>
                            </tr>
                        </thead>
                        <tbody class="text-theme-main">
                            @foreach (var item in Model.Inscricoes)
                            {
                                <tr>
                                    <td class="py-3 fw-semibold">
                                        @(item.Participante.Nome)
                                    </td>
                                    <td class="py-3 text-end text-theme-muted font-monospace small">
                                        @(item.Participante.Email)
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Inscricoes" asp-action="Delete" asp-route-idParticipante="@item.ParticipanteId" asp-route-idEvento="@item.EventoId" class="btn btn-danger" style="color: var(--primary-accent);">Eliminar</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="d-flex h-75 align-items-center justify-content-center text-center p-4">
                    <div class="text-theme-muted">
                        <i class="bi bi-people fs-2 d-block mb-2 text-opacity-50"></i>
                        <p class="mb-0 small">Ainda não existem participantes inscritos neste evento.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="form-group mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">Voltar à Lista</a>
</div>
