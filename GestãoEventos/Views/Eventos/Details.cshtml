@model GestãoEventos.ViewModel.Eventos.EventoViewModel

@{
    ViewData["Title"] = "Detalhes";
}

<h1 class="text-theme-main fw-bold my-4">@ViewData["Title"]</h1>

<div class="bg-theme-surface p-4 rounded-3 shadow-sm">
    <h4 class="text-theme-main">Dados do Evento</h4>
    <hr />

    <dl class="row text-theme-main">
        <dt class="col-sm-3 text-theme-muted">Nome</dt>
        <dd class="col-sm-9 fw-bold">@Model.Nome</dd>

        <dt class="col-sm-3 text-theme-muted">Data</dt>
        <dd class="col-sm-9">@Model.Data.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3 text-theme-muted">Local</dt>
        <dd class="col-sm-9">@Model.Local</dd>
    </dl>
</div>

<div class="form-group mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">Voltar à Lista</a>
</div>
